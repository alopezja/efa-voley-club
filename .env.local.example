# Copia este archivo como `.env.local` y llena los valores.
# En desarrollo usa las llaves del proyecto Supabase de DESARROLLO (no el de producción).

# Supabase (proyecto de DESARROLLO)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (bucket de desarrollo, o se puede dejar vacío si no pruebas fotos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Resend (correos) — opcional en desarrollo (si está vacío, no envía)
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=

# Web Push / VAPID — opcional en desarrollo
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Cron (recordatorios) — opcional en desarrollo
CRON_SECRET=
